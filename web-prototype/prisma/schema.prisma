// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String     @id @default(cuid())
  name        String
  description String
  category    Category
  price       Float // Using Decimal would be better for money, but Float is fine for demo
  imageUrl    String
  stock       Int        @default(0)
  isActive    Boolean    @default(true)
  cartItems   CartItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Indexes for better query performance
  @@index([category])
  @@index([isActive])
  @@index([createdAt])
  @@map("products")
}

model CartItem {
  id        String   @id @default(cuid())
  productId String
  quantity  Int      @default(1)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Only one entry per product
  @@unique([productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id         String      @id @default(cuid())
  products   String // JSON string of ordered products
  totalPrice Float
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Category {
  mobile
  laptop
  pc
}
